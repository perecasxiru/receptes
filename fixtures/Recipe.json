{
    "model": "receptes_app.recipe",
    "pk": 2,
    "fields": {
        "name": "Croquetes d'espinacs",
        "slug": "croquetes-despinacs",
        "link": null,
        "ingredients": "<ul><li>300g d'espinacs</li><li>1 ceba</li><li>formatge ratllat</li><li>30g de farina</li><li>75g de llet</li><li>1 ou</li><li>farina de galeta</li><li>oli, sal i pebre</li></ul>",
        "preparation": "<ol><li>Bullir els 300g d'espinacs en poca aigua durant 2 minuts.</li><li>Passar-los a un colador per escórrer-los i esprémer per treure'n l'aigua.</li><li>Tallar 1 ceba ben petita i sofregir en oli.</li><li>Afegir-hi els espinacs i coure-ho 2 minuts.</li><li>Afegir-hi formatge ratllat i integrar-ho tot bé.</li><li>Afegir 30g de farina i coure-la uns 10min</li><li>Afegir els 75g de llet i remenar fins que faci beixamel.</li><li>Deixar refredar.</li><li>Formar les croquetes i arrebossar-les amb ou i farina de galeta.</li><li>Fregir-les.</li></ol>",
        "prep_time": null,
        "created_at": "2024-11-25",
        "updated_at": "2024-12-09",
        "image": "",
