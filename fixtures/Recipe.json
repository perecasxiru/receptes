{
    "model": "receptes_app.recipe",
    "pk": 2,
    "fields": {
        "name": "Croquetes d'espinacs",
        "slug": "croquetes-despinacs",
        "link": null,
        "ingredients": "300g d'espinacs\n1 ceba\nformatge ratllat\n30g de farina\n75g de llet\n1 ou\nfarina de galeta\noli, sal i pebre",
        "preparation": "Bullir els 300g d'espinacs en poca aigua durant 2 minuts.\nPassar-los a un colador per escórrer-los i esprémer per treure'n l'aigua.\nTallar 1 ceba ben petita i sofregir en oli.\nAfegir-hi els espinacs i coure-ho 2 minuts.\nAfegir-hi formatge ratllat i integrar-ho tot bé.\nAfegir 30g de farina i coure-la uns 10min\nAfegir els 75g de llet i remenar fins que faci beixamel.\nDeixar refredar.\nFormar les croquetes i arrebossar-les amb ou i farina de galeta.\nFregir-les.",
        "prep_time": null,
        "created_at": "2024-11-25",
        "updated_at": "2024-12-09",
        "image": "",
        "tags": [
            2,
            3
        ],
