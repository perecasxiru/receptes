{
    "model": "receptes_app.recipe",
    "pk": 39,
    "fields": {
        "name": "Esferificació de soja",
        "slug": "esferificacio-de-soja",
        "link": null,
        "ingredients": "360ml d'aigua\n2.5g d'alginato\n3.1g de lactato o 6.2 de glucononactato\n80ml de soja\n1.2g de xantana\nOli",
        "preparation": "Barrejar 90ml d0aigua amb la soja. Afegir-hi un raig d'oli, 1.2g de xantana, 6.2g de glucononactato i triturar-ho molt bé. Deixar-ho reposar durant 2h. En cas que es vulgui, es pot treure l'aire de la mescla amb una envasadora al buit.\nBarrejar 270ml d'aigua amb 2.5g d'alginato, triturar-ho bé i deixar reposar durant 2h.\nFormar les esferes amb una cullera d'esferes o amb un biberó si es volen fer petites dins de l'aigua amb alginato. Esperar un minutet i passar-les a un bol amb aigua, oli o soja abans de consumir-les.",
        "prep_time": null,
